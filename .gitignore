# ==============================================================================
# 个人知识库 RAG Agent - Git 忽略规则
# ==============================================================================

# --- 1. 核心敏感文件（保护 API Key 等凭据，严禁提交）---
.env
*.env
!.env.example
knowledge-agent/.env
knowledge-agent/*.env
!knowledge-agent/.env.example

# --- 2. 向量数据库持久化目录与备份（运行时由 ingest.py 自动生成）---
db/
db_test/
backups/
knowledge-agent/db/
knowledge-agent/db_test/
knowledge-agent/backups/
*.sqlite3
*.sqlite3-journal
*.bin

# --- 3. Python 编译缓存与临时产物 ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- 4. 虚拟环境 ---
.venv/
venv/
ENV/
env/
venv.bak/
env.bak/

# --- 5. 编辑器与 IDE 配置 ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# --- 6. 操作系统与临时文件 ---
.DS_Store
Thumbs.db
Desktop.ini
~$*
*.tmp
*.log

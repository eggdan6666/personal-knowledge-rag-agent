# ==============================================================================
# 个人知识库 RAG Agent - 配置文件模板
# 使用方法：复制本文件并重命名为 .env，然后填入你的 LLM API Key 与配置
# 注意：.env 文件包含敏感密钥，已在 .gitignore 中忽略，切勿提交到公开仓库！
# ==============================================================================

# ===== 1. 大模型 (LLM) 接口配置 =====
# 支持任意兼容 OpenAI 规范的 API 接口（如 DeepSeek、火山方舟/豆包、Moonshot、Qwen、OpenAI 等）

# --- 预设方案 A：DeepSeek（推荐）---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# --- 预设方案 B：火山方舟（豆包 / 托管模型）---
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=ep-20250101xxxxxx-xxxxx  # 填写方舟「推理接入点」或开通的模型 ID

# --- 当前激活的配置 ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=把你的key粘贴到这里
LLM_MODEL=deepseek-chat

# ===== 2. 数据与向量库配置 =====
# DATA_PATH: 文档存放路径。留空则默认读取 "../输出资料存放处" 或 "data_test"
# 支持相对路径（相对于 knowledge-agent 目录）或绝对路径
# Windows 路径反斜杠直接写，不需要加引号，例如：../输出资料存放处 或 data_test
DATA_PATH=../输出资料存放处

# DB_PATH: 本地向量库持久化目录（默认 db）
DB_PATH=db

# TOP_K: 每次问答检索召回的最相关文本块数量（推荐 3-8，默认 5）
TOP_K=5
